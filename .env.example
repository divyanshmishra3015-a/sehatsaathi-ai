# JanSwasthya Setu AI - Environment Configuration Example
# Copy this file to .env and configure your keys if integrating external services.
# The application operates with full functionality in DEMO / FALLBACK mode if keys are omitted.

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# AI LLM Provider Configuration (Optional - safe conservative fallback engine is built-in)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (Optional - in-memory and SQLite supported)
# DATABASE_URL=sqlite:///./janswasthya.db
# SUPABASE_URL=https://your-supabase-id.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key

# SMS / WhatsApp Notification Gateway (Optional)
# SMS_GATEWAY_API_KEY=your_sms_provider_key
